{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "backend", "run", "uvicorn", "vik.api:app", "--host", "127.0.0.1", "--port", "8000", "--reload", "--reload-dir", "vik"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "backend", "run", "uvicorn", "vik.api:app", "--host", "127.0.0.1", "--port", "8100"],
      "env": { "RATE_LIMIT_PER_MIN": "100000", "WEB_ORIGIN": "http://localhost:3100" },
      "port": 8100,
      "autoPort": false
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "start", "--", "-p", "3100"],
      "env": { "API_INTERNAL_URL": "http://localhost:8100" },
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "web-running",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "api-running",
      "url": "http://localhost:8000",
      "port": 8000
    }
  ]
}

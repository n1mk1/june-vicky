# Vicky environment. Copy to `.env` (gitignored) and fill in what you need.
# The backend reads `.env` and `../.env` (pydantic-settings; env var = uppercase field name in
# backend/vicky/config.py). docker-compose loads `.env` into api/worker if it exists, but always
# overrides DATABASE_URL, REDIS_URL, JOBS_MODE and WEB_ORIGIN with the in-network values.
# On Render, these are set in render.yaml / the dashboard; never put secrets in Docker build args.

# ---------- api + worker: infrastructure ----------
# Postgres (Render: fromDatabase vicky-db connectionString). Host default matches `docker compose up db`.
DATABASE_URL=postgresql://vicky:vicky@localhost:5432/vicky
# Key Value / Redis / Valkey (Render: fromService vicky-kv connectionString).
REDIS_URL=redis://localhost:6379
# inline = arq jobs run inside the API process (free tier); worker = separate `arq vicky.jobs.WorkerSettings`.
JOBS_MODE=inline
# Browser origin of the web app: CORS allow-origin and cookie domain.
WEB_ORIGIN=http://localhost:3000

# ---------- api + worker: access gate (secrets) ----------
# Code entered once on the landing page; exchanged for a signed HTTP-only cookie.
ACCESS_CODE=vicky-demo
# Signs the access cookie. Render generates it (generateValue). Locally: `openssl rand -base64 32`.
COOKIE_SECRET=dev-only-change-me
# COOKIE_NAME=vicky_access
# COOKIE_MAX_AGE_S=2592000
# true behind HTTPS (Render); false for http://localhost.
COOKIE_SECURE=false

# ---------- api + worker: LLM and voice (secrets) ----------
# Empty = offline agents (with LLM_MODE=auto).
ANTHROPIC_API_KEY=
# Server-side only; the browser gets short-lived STT tokens.
ELEVENLABS_API_KEY=
# auto: Claude when ANTHROPIC_API_KEY is set, offline agents otherwise | live: always Claude | offline: never Claude
LLM_MODE=auto
# Fall back to offline output when a live call fails.
# LLM_SERVER_FALLBACKS=true
# Hard daily spend cap for LLM routes, in USD.
DAILY_USD_BUDGET=5
# MODEL_DEEP=claude-opus-5-5
# MODEL_FAST=claude-sonnet-5-5
# MODEL_TINY=claude-haiku-5-5
# ElevenLabs voice for Vicky herself.
# VICKY_VOICE_ID=

# ---------- api + worker: knowledge-base search (docs/08-RAG.md) ----------
# Voyage AI embeddings and reranking. Empty = BM25 keyword search only. Vectors also need pgvector.
VOYAGE_API_KEY=
# EMBED_MODEL=voyage-4
# RERANK_MODEL=rerank-2.5
# RERANK_MODEL_FAST=rerank-2.5-lite
# Below this retrieval confidence: a second, wider pass (Ask Vicky) or no notes (court turns).
# RAG_CONF_MIN=0.55
# The catch-all's vault snapshot cap, in tokens.
# RAG_FULL_MAX_TOKENS=300000
# On a rebuild, copy vectors of byte-identical chunks instead of re-embedding them.
# RAG_REUSE_EMBEDDINGS=true

# ---------- api: limits (defaults shown) ----------
# RATE_LIMIT_PER_MIN=240
# ACCESS_ATTEMPTS_PER_MIN=5
# UPLOAD_MAX_BYTES=10485760
# Knowledge base imports: per file, and the most one zip may expand to.
# KB_UPLOAD_MAX_BYTES=52428800
# KB_UNZIP_MAX_BYTES=209715200
# OCR: tesseract binary if it isn't on PATH (the API image ships it), and the page cap per PDF.
# TESSERACT_CMD=
# OCR_MAX_PAGES=80
# CHAIR_TIMEOUT_S=1.5
# INTERRUPT_VETO_TIMEOUT_S=1.0

# ---------- web (Next.js; read at request time, never baked into the build) ----------
# Base URL the Next.js server uses to reach the API (route-handler proxy for /api/v1/*).
# docker compose (profile full) sets http://api:8000. On Render: http://<vicky-api hostport>.
API_INTERNAL_URL=http://localhost:8000
# Public WebSocket base the browser connects to (wss://<vicky-api>.onrender.com on Render).
API_PUBLIC_WS_URL=ws://localhost:8000
